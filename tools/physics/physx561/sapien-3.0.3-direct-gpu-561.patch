+// Preserve SAPIEN 3.0.3's public old-PhysX memory-config reference ABI (48 B).
+// Field order/defaults copied from installed PhysX 5.3.1 PxSceneDesc.h.
+#pragma once
+#include <PxSceneDesc.h>
+namespace physx {
+struct PxgDynamicsMemoryConfig {
+  PxU32 tempBufferCapacity=16*1024*1024;
+  PxU32 maxRigidContactCount=1024*512;
+  PxU32 maxRigidPatchCount=1024*80;
+  PxU32 heapCapacity=64*1024*1024;
+  PxU32 foundLostPairsCapacity=256*1024;
+  PxU32 foundLostAggregatePairsCapacity=1024;
+  PxU32 totalAggregatePairsCapacity=1024;
+  PxU32 maxSoftBodyContacts=1024*1024;
+  PxU32 maxFemClothContacts=1024*1024;
+  PxU32 maxParticleContacts=1024*1024;
+  PxU32 collisionStackSize=64*1024*1024;
+  PxU32 maxHairContacts=1024*1024;
+  operator PxGpuDynamicsMemoryConfig()const{
+    PxGpuDynamicsMemoryConfig value;
+    value.tempBufferCapacity=tempBufferCapacity;
+    value.maxRigidContactCount=maxRigidContactCount;value.maxRigidPatchCount=maxRigidPatchCount;
+    value.heapCapacity=heapCapacity;value.foundLostPairsCapacity=foundLostPairsCapacity;
+    value.foundLostAggregatePairsCapacity=foundLostAggregatePairsCapacity;value.totalAggregatePairsCapacity=totalAggregatePairsCapacity;
+    value.maxDeformableVolumeContacts=maxSoftBodyContacts;value.maxDeformableSurfaceContacts=maxFemClothContacts;
+    value.maxParticleContacts=maxParticleContacts;value.collisionStackSize=collisionStackSize;
+    return value;
+  }
+};
+static_assert(sizeof(PxgDynamicsMemoryConfig)==48);
