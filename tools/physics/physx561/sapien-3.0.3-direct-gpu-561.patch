+// SAPIEN 3.0.3 -> PhysX 5.6.1 API layout adapter.
+// Copies/reorders source state only; no physical constants or dynamics changed.
+#pragma once
+#include <PxDirectGPUAPI.h>
+#include <cuda_runtime.h>
+#include "sapien/array.h"
+#include <stdexcept>
+namespace sapien::physx {
+void compat561_gather(float*,float const*,unsigned const*,int,int);
+inline void compat561_ok(bool ok){if(!ok)throw std::runtime_error("PhysX 5.6.1 direct GPU API failed");}
+inline void compat561_cuda(cudaError_t e){if(e!=cudaSuccess)throw std::runtime_error(cudaGetErrorString(e));}
+// cudaMemcpy2D D2D is not host-blocking. Complete the copy before the
+// non-blocking PhysX stream can reuse/read the same temporary allocation.
+inline void compat561_copy2d(void* dst,size_t dp,void const* src,size_t sp,size_t width,size_t rows,cudaMemcpyKind kind){
+  compat561_cuda(cudaMemcpy2D(dst,dp,src,sp,width,rows,kind));
+  compat561_cuda(cudaStreamSynchronize(0));
+}
+inline void compat561_event(CUevent e){if(e)compat561_cuda(cudaEventSynchronize(e));}
+inline void compat561_finish(CUevent e){if(e)compat561_cuda(cudaEventRecord(e,0));}
+inline CudaArray compat561_indices(void const* old,int n){
+  CudaArray indices({n},"u4");compat561_copy2d(indices.ptr,4,(char const*)old+4,16,4,n,cudaMemcpyDeviceToDevice);return indices;
+}
+inline void compat561_body_get(::physx::PxScene* scene,void* dst,void const* old,int n,CUevent finish){
+  auto indices=compat561_indices(old,n);CudaArray tmp({n*7},"f4");auto& api=scene->getDirectGPUAPI();
+  using T=::physx::PxRigidDynamicGPUAPIReadType;
+  for(auto entry:{std::pair{T::eGLOBAL_POSE,0},std::pair{T::eLINEAR_VELOCITY,32},std::pair{T::eANGULAR_VELOCITY,48}}){
+    int width=entry.first==T::eGLOBAL_POSE?28:12;
+    compat561_ok(api.getRigidDynamicData(tmp.ptr,(unsigned*)indices.ptr,entry.first,n));
+    compat561_copy2d((char*)dst+entry.second,64,tmp.ptr,width,width,n,cudaMemcpyDeviceToDevice);
+  }compat561_finish(finish);
+}
+// kind 0 = full body state, 1 = force, 2 = torque; old force rows have 16-byte pitch.
+inline void compat561_body_set(::physx::PxScene* scene,void const* src,void const* old,int kind,int n,CUevent start,CUevent finish){
+  compat561_event(start);auto indices=compat561_indices(old,n);CudaArray tmp({n*7},"f4");auto& api=scene->getDirectGPUAPI();using T=::physx::PxRigidDynamicGPUAPIWriteType;
+  if(kind){compat561_copy2d(tmp.ptr,12,src,16,12,n,cudaMemcpyDeviceToDevice);compat561_ok(api.setRigidDynamicData(tmp.ptr,(unsigned*)indices.ptr,kind==1?T::eFORCE:T::eTORQUE,n));}
+  else for(auto entry:{std::pair{T::eGLOBAL_POSE,0},std::pair{T::eLINEAR_VELOCITY,32},std::pair{T::eANGULAR_VELOCITY,48}}){
+    int width=entry.first==T::eGLOBAL_POSE?28:12;
+    compat561_copy2d(tmp.ptr,width,(char const*)src+entry.second,64,width,n,cudaMemcpyDeviceToDevice);
+    compat561_ok(api.setRigidDynamicData(tmp.ptr,(unsigned*)indices.ptr,entry.first,n));
+  }compat561_finish(finish);
+}
+inline void compat561_art_get(::physx::PxScene* scene,void* dst,unsigned const* indices,::physx::PxArticulationGPUAPIReadType::Enum kind,int n,CUevent finish){
+  compat561_ok(scene->getDirectGPUAPI().getArticulationData(dst,indices,kind,n));compat561_finish(finish);
+}
+inline void compat561_art_vel_get(::physx::PxScene* scene,void* dst,unsigned const* indices,int n,int links,CUevent finish){
+  auto& api=scene->getDirectGPUAPI();int count=n*links;CudaArray tmp({count*3},"f4");using T=::physx::PxArticulationGPUAPIReadType;
+  compat561_ok(api.getArticulationData(tmp.ptr,indices,T::eLINK_ANGULAR_VELOCITY,n));compat561_copy2d(dst,24,tmp.ptr,12,12,count,cudaMemcpyDeviceToDevice);
