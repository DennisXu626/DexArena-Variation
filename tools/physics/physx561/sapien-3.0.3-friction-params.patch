+Eigen::Vector3f PhysxArticulationJoint::getFrictionParams() const {
+  auto j = getPxJoint();
+  if (!j || mAxes.size() != 1) {
+    throw std::runtime_error("friction parameters require a revolute or prismatic joint");
+  }
+  auto params = j->getFrictionParams(mAxes[0]);
+  return {params.staticFrictionEffort, params.dynamicFrictionEffort,
+          params.viscousFrictionCoefficient};
+}
+
+void PhysxArticulationJoint::setFrictionParams(float staticEffort, float dynamicEffort,
+                                              float viscous) {
+  auto j = getPxJoint();
+  if (!j || mAxes.size() != 1) {
+    throw std::runtime_error("friction parameters require a revolute or prismatic joint");
+  }
+  if (!std::isfinite(staticEffort) || !std::isfinite(dynamicEffort) ||
+      !std::isfinite(viscous) || staticEffort < 0 || dynamicEffort < 0 || viscous < 0) {
+    throw std::invalid_argument("friction parameters must be finite and nonnegative");
+  }
+  j->setFrictionParams(mAxes[0], {staticEffort, dynamicEffort, viscous});
+  mFrictionParamsEnabled = true;
+}
