+
+void destroyCudaSemaphoreNoThrow(cudaExternalSemaphore_t &semaphore, cudaStream_t stream) noexcept {
+  if (!semaphore) {
+    return;
+  }
+  auto result = cudaStreamSynchronize(stream);
+  if (result != cudaSuccess) {
+    fprintf(stderr, "Semaphore cleanup cudaStreamSynchronize: %s\n", cudaGetErrorString(result));
+  }
+  result = cudaDestroyExternalSemaphore(semaphore);
+  if (result != cudaSuccess) {
+    fprintf(stderr, "Semaphore cleanup cudaDestroyExternalSemaphore: %s\n",
+            cudaGetErrorString(result));
+  }
+  semaphore = nullptr;
+}
+}
