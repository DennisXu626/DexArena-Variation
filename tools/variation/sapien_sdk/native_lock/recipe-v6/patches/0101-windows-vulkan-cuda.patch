+void logCudaCleanupError(cudaError_t result, char const *operation) noexcept {
+  if (result != cudaSuccess) {
+    fprintf(stderr, "CUDA block cleanup %s: %s\n", operation, cudaGetErrorString(result));
+  }
+}
+}
+
+CudaExternalMemory::~CudaExternalMemory() noexcept {
+  if (!pointer && !memory) {
+    return;
+  }
+  int previousDevice = -1;
+  logCudaCleanupError(cudaGetDevice(&previousDevice), "cudaGetDevice");
+  auto result = cudaSetDevice(cudaDeviceId);
+  if (result != cudaSuccess) {
+    logCudaCleanupError(result, "cudaSetDevice; owner cleanup skipped");
+    if (previousDevice >= 0) {
+      logCudaCleanupError(cudaSetDevice(previousDevice), "restore cudaSetDevice");
+    }
+    return;
+  }
+  logCudaCleanupError(cudaDeviceSynchronize(), "cudaDeviceSynchronize");
+  if (pointer) {
+    logCudaCleanupError(cudaFree(pointer), "cudaFree");
+    pointer = nullptr;
+  }
+  if (memory) {
+    logCudaCleanupError(cudaDestroyExternalMemory(memory), "cudaDestroyExternalMemory");
+    memory = nullptr;
+  }
+  if (previousDevice >= 0 && previousDevice != cudaDeviceId) {
+    logCudaCleanupError(cudaSetDevice(previousDevice), "restore cudaSetDevice");
+  }
+}
+
+std::shared_ptr<CudaExternalMemory> Allocator::getCudaExternalMemory(
+    vk::Device device, VkDeviceMemory memory, int cudaDeviceId) {
+  std::lock_guard<std::mutex> lock(mDeviceMemorySizesMutex);
+  auto key = std::make_pair(memory, cudaDeviceId);
+  auto cached = mCudaMemoryBlocks.find(key);
+  if (cached != mCudaMemoryBlocks.end()) {
+    if (std::getenv("SAPIEN_CUDA_INTEROP_TRACE")) {
+      fprintf(stderr, "CUDA interop block cache hit memory_object=%llu cuda_device=%d\n",
+              static_cast<unsigned long long>(cached->second->size), cudaDeviceId);
+    }
+    return cached->second;
+  }
+  auto allocation = mDeviceMemorySizes.find(memory);
+  if (allocation == mDeviceMemorySizes.end()) {
+    throw std::runtime_error("Vulkan device memory allocation size is unavailable");
+  }
+  auto owner = std::make_shared<CudaExternalMemory>();
+  owner->size = allocation->second;
+  owner->cudaDeviceId = cudaDeviceId;
+  cudaExternalMemoryHandleDesc desc{};
+  desc.type = cudaExternalMemoryHandleTypeOpaqueWin32;
+  desc.size = owner->size;
+  auto handle = device.getMemoryWin32HandleKHR(
+      {memory, vk::ExternalMemoryHandleTypeFlagBits::eOpaqueWin32});
+  desc.handle.win32.handle = handle;
+  auto result = cudaImportExternalMemory(&owner->memory, &desc);
+  CloseHandle(handle);
+  if (result != cudaSuccess) {
+    throw std::runtime_error("CUDA block import failed: " + std::string(cudaGetErrorString(result)) +
+                             " (memory_object=" + std::to_string(desc.size) + ")");
+  }
+  cudaExternalMemoryBufferDesc mapping{};
+  mapping.size = owner->size;
+  result = cudaExternalMemoryGetMappedBuffer(&owner->pointer, owner->memory, &mapping);
+  if (result != cudaSuccess) {
+    throw std::runtime_error("CUDA block mapping failed: " + std::string(cudaGetErrorString(result)) +
+                             " (memory_object=" + std::to_string(desc.size) + ")");
+  }
+  mCudaMemoryBlocks.emplace(key, owner);
+  if (std::getenv("SAPIEN_CUDA_INTEROP_TRACE")) {
+    fprintf(stderr, "CUDA interop block import and map memory_object=%llu cuda_device=%d\n",
+            static_cast<unsigned long long>(owner->size), cudaDeviceId);
+  }
+  return owner;
+}
+#endif
