+void VKAPI_CALL Allocator::memoryAllocated(VmaAllocator, uint32_t, VkDeviceMemory memory,
+                                          VkDeviceSize size, void *userData) {
+  auto &allocator = *static_cast<Allocator *>(userData);
+  std::lock_guard<std::mutex> lock(allocator.mDeviceMemorySizesMutex);
+  allocator.mDeviceMemorySizes.emplace(memory, size);
+}
+
+void VKAPI_CALL Allocator::memoryFreed(VmaAllocator, uint32_t, VkDeviceMemory memory,
+                                      VkDeviceSize, void *userData) {
+  auto &allocator = *static_cast<Allocator *>(userData);
+  std::lock_guard<std::mutex> lock(allocator.mDeviceMemorySizesMutex);
+#if defined(_WIN32) && defined(SVULKAN2_CUDA_INTEROP)
+  for (auto entry = allocator.mCudaMemoryBlocks.begin();
+       entry != allocator.mCudaMemoryBlocks.end();) {
+    if (entry->first.first == memory) {
+      entry = allocator.mCudaMemoryBlocks.erase(entry);
+    } else {
+      ++entry;
+    }
+  }
+#endif
+  allocator.mDeviceMemorySizes.erase(memory);
+}
+
+VkDeviceSize Allocator::getDeviceMemoryAllocationSize(VkDeviceMemory memory) const {
+  std::lock_guard<std::mutex> lock(mDeviceMemorySizesMutex);
+  auto entry = mDeviceMemorySizes.find(memory);
+  if (entry == mDeviceMemorySizes.end()) {
+    throw std::runtime_error("Vulkan device memory allocation size is unavailable");
+  }
+  return entry->second;
+}
